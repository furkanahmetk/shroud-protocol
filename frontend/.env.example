# Shroud Protocol Frontend Configuration
# Copy this file to .env and fill in your values

# Casper Network Configuration
NEXT_PUBLIC_NETWORK_NAME=casper-test
NEXT_PUBLIC_CONTRACT_HASH=your_contract_hash_here

# Server-side RPC target (used by /api/proxy)
CASPER_NODE_RPC_URL=https://node.testnet.casper.network/rpc

# Casper Cloud (server-side only, never expose as NEXT_PUBLIC)
# IMPORTANT: Use raw key value (do NOT prefix with "Bearer ").
CSPR_CLOUD_API_TOKEN=your_cspr_cloud_api_token_here
CSPR_CLOUD_REST_BASE_URL=https://api.testnet.cspr.cloud

# Legacy explorer fallback (server-side)
LEGACY_EXPLORER_API_URL=https://api.testnet.cspr.live

# Data source mode: hybrid | cloud-only | legacy-only
CSPR_DATA_SOURCE_MODE=hybrid
